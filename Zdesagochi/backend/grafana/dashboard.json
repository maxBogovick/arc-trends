{
  "title": "Zdesagochi Backend",
  "uid": "zdesagochi-backend",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{method}} {{path}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pet Actions Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(pet_actions_total[5m])",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Engine Apply Duration (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "engine_apply_duration_ms",
          "legendFormat": "Engine latency ms"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP Error Rate (4xx/5xx)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_requests_total{status=~\"[45]..\"}[5m])",
          "legendFormat": "{{method}} {{path}} {{status}}"
        }
      ]
    }
  ]
}
