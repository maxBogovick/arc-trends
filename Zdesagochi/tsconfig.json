{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@zdesagochi/personality-core": ["packages/personality-core/src/index.ts"],
      "@zdesagochi/personality-pet-preset": ["packages/personality-pet-preset/src/index.ts"]
    }
  },
  "include": ["src", "packages"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
